---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  /** Root-relative path to the social-share image. */
  ogImage?: string;
}

const { title, description, ogImage = '/images/marvels-luxe-bhutan-logo.png' } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogUrl = new URL(ogImage, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/favicon.png" />

    <meta property="og:site_name" content="Marvels Luxe Bhutan" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    <script is:inline>
      // Show the transition overlay immediately when arriving from another page (no flash).
      try {
        if (sessionStorage.getItem('pt-active')) document.documentElement.classList.add('pt-active');
      } catch (e) {}
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Montserrat:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="page-transition" aria-hidden="true">
      <img src="/images/site-icon.png" alt="" width="96" height="96" />
    </div>
    <Header />
    <main id="top">
      <slot />
    </main>
    <Footer />

    <script>
      import { initRevealOnScroll } from '../scripts/reveal';
      initRevealOnScroll();
      import '../scripts/page-transition';
    </script>
  </body>
</html>
