---
interface Props {
  image: string;
  alt: string;
  date: string;
  author: string;
  title: string;
  desc: string;
  href?: string;
  /** Present only on the /blog.html grid, where cards reveal on scroll. */
  delay?: string;
  reveal?: boolean;
}
const { image, alt, date, author, title, desc, href = '#', delay, reveal = false } = Astro.props;
const delayClass: Record<string, string> = { '1': '[transition-delay:0.1s]', '2': '[transition-delay:0.2s]', '3': '[transition-delay:0.3s]' };
---

<article class:list={["relative flex-[0_0_84%] h-130 rounded-none overflow-hidden min-[640px]:flex-[0_0_calc(50%_-_10px)] min-[1024px]:flex-[0_0_calc(33.333%_-_14px)] min-[1024px]:h-150 [&_img]:absolute [&_img]:inset-0 [&_img]:w-full [&_img]:h-full [&_img]:object-cover [&_img]:[transition:transform_0.9s_ease] [&:hover_img]:[transform:scale(1.08)] after:content-[''] after:absolute! after:inset-0! after:[background:linear-gradient(180deg,_rgba(0,0,0,0)_60%,_rgba(0,0,0,0.5)_82%,_rgba(0,0,0,0.88)_100%)] after:[transition:background_0.4s_ease]! [&:hover::after]:[background:linear-gradient(180deg,_rgba(0,0,0,0)_30%,_rgba(0,0,0,0.62)_65%,_rgba(0,0,0,0.93)_100%)]! [.blog-index-grid_&]:flex-none blog-slide", reveal && "opacity-[0] [transform:translateY(32px)] [transition:opacity_0.7s_ease,_transform_0.7s_ease] [&.is-visible]:opacity-[1] [&.is-visible]:[transform:translateY(0)] reveal", delay && delayClass[delay]]}>
  <img src={image} alt={alt} />
  <div class="absolute left-5.5 right-5.5 bottom-5.5 z-2 text-soft-white">
    <p class="text-[11px] tracking-[0.06em] uppercase text-brand-yellow">{date} <span class="text-[rgba(250,250,248,0.75)] normal-case tracking-[0.02em]">&middot; By {author}</span></p>
    <h3 class="font-heading text-[21px] leading-[1.3] mt-2 text-soft-white" set:html={title} />
    <div class="max-h-0 opacity-[0] overflow-hidden [transition:max-height_0.4s_ease,_opacity_0.3s_ease,_margin-top_0.4s_ease] [.blog-slide:hover_&]:max-h-40 [.blog-slide:hover_&]:opacity-[1] [.blog-slide:hover_&]:mt-2.5">
      <p class="text-[13px] leading-[1.6] text-[rgba(250,250,248,0.78)]" set:html={desc} />
      <a href={href} class="inline-block mt-3 pt-2.5 border-t border-t-brand-yellow text-[11px] font-semibold tracking-[0.08em] uppercase text-brand-yellow [transition:color_0.3s_ease] hover:text-soft-white">Read More</a>
    </div>
  </div>
</article>
