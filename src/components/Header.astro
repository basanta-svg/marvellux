---
import NavItem from './NavItem.astro';
import { navLeft, navRight } from '../data/nav';
const mobileNav = [...navLeft, ...navRight];
---

<header class="fixed top-0 left-0 right-0 z-200 py-5.5 px-0 [transition:background_0.4s_ease,_padding_0.4s_ease,_box-shadow_0.4s_ease,_border-color_0.4s_ease] border-b border-b-transparent [&.scrolled]:bg-[rgba(255,255,255,0.97)] [&.scrolled]:[backdrop-filter:blur(10px)] [&.scrolled]:py-3 [&.scrolled]:px-0 [&.scrolled]:shadow-[0_4px_24px_rgba(30,30,30,0.06)] [&.scrolled]:border-b-charcoal-line site-header" id="site-header">
  <div class="max-w-320 my-0 mx-auto py-0 px-(--gutter) [.site-header_&]:flex [.site-header_&]:items-center [.site-header_&]:justify-between [.site-header_&]:gap-6 [.site-header_&]:relative max-[1023px]:[.site-header_&]:justify-start">
    <nav class="hidden min-[1024px]:flex min-[1024px]:items-center min-[1024px]:gap-1.5 min-[1024px]:flex-[1_1_0] min-[1024px]:justify-start" aria-label="Primary">
      {navLeft.map((group) => <NavItem group={group} />)}
    </nav>

    <a href="/" class="flex items-center [&_img]:h-20 [&_img]:w-auto [&_img]:[transition:opacity_0.3s_ease,_height_0.3s_ease] [.site-header.scrolled_&_img]:h-12! max-[1023px]:[&_img]:h-11 max-[1023px]:[.site-header.scrolled_&_img]:h-9! min-[1024px]:flex-[0_0_auto]" aria-label="Marvels Luxe — home">
      <img class="block [.site-header.scrolled_&]:hidden! [.nav-open_&]:hidden" src="/images/marvels-luxe-bhutan-white-logo.png" alt="Marvels Luxe" />
      <img class="hidden [.site-header.scrolled_&]:block! [.nav-open_&]:block" src="/images/marvels-luxe-bhutan-logo.png" alt="Marvels Luxe" />
    </a>

    <nav class="hidden min-[1024px]:flex min-[1024px]:items-center min-[1024px]:gap-1.5 min-[1024px]:flex-[1_1_0] min-[1024px]:justify-end" aria-label="Secondary">
      {navRight.map((group) => <NavItem group={group} />)}
    </nav>

    <button class="w-10 h-10 flex items-center justify-center text-soft-white [.site-header.scrolled_&]:text-charcoal [&_svg]:w-5.5 [&_svg]:h-5.5 min-[1024px]:hidden max-[1023px]:absolute max-[1023px]:right-(--gutter) max-[1023px]:top-1/2 max-[1023px]:[transform:translateY(-50%)] hamburger" aria-label="Open menu">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
    </button>
  </div>
</header>

<!-- Mobile nav -->
<div class="fixed inset-0 bg-charcoal z-300 pt-25 pr-7 pb-10 pl-7 overflow-y-auto [transform:translateX(100%)] [transition:transform_0.5s_cubic-bezier(.16,1,.3,1)] [&.open]:[transform:translateX(0)] mobile-nav" aria-label="Mobile navigation">
  <button class="absolute top-5.5 right-5.5 w-10.5 h-10.5 text-soft-white flex items-center justify-center border border-white-line rounded-[50%] [&_svg]:w-4.5 [&_svg]:h-4.5 mobile-nav-close" aria-label="Close menu">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l12 12M18 6L6 18"></path></svg>
  </button>
  <ul class="flex flex-col [&>li]:border-b [&>li]:border-b-white-line">
    {
      mobileNav.map((g) =>
        g.children ? (
          <li class="mobile-nav-item">
            <button class="w-full flex items-center justify-between py-4.5 px-0.5 font-heading text-[20px] text-soft-white [&_svg]:w-4 [&_svg]:h-4 [&_svg]:[transition:transform_0.3s_ease] [.mobile-nav-item.open_&_svg]:[transform:rotate(45deg)] mobile-nav-toggle">
              {g.label}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"></path></svg>
            </button>
            <div class="max-h-0 overflow-hidden [transition:max-height_0.4s_ease] [.mobile-nav-item.open_&]:max-h-80 [&_a]:block [&_a]:pt-3 [&_a]:pr-0.5 [&_a]:pb-3 [&_a]:pl-3.5 [&_a]:text-[14px] [&_a]:text-[rgba(250,250,248,0.75)] [&_a]:border-l-2 [&_a]:border-l-brand-yellow [&_a]:mb-0.5">
              {g.children.map((c) => <a href={c.href}>{c.label}</a>)}
            </div>
          </li>
        ) : (
          <li>
            <a class="w-full flex items-center justify-between py-4.5 px-0.5 font-heading text-[20px] text-soft-white" href={g.href}>{g.label}</a>
          </li>
        ),
      )
    }
  </ul>
  <div class="mt-8 flex flex-col gap-3.5">
    <a href="/contact.html" class="inline-flex items-center gap-2.5 font-body font-semibold text-[12px] tracking-[0.06em] uppercase py-4 px-7.5 rounded-pill [transition:background_0.3s_ease,_color_0.3s_ease,_border-color_0.3s_ease,_transform_0.3s_ease] whitespace-nowrap active:[transform:scale(0.97)] bg-transparent text-soft-white border border-white-line hover:border-brand-yellow hover:text-brand-yellow w-full justify-center">Chat With Us</a>
  </div>
</div>

<script>
  import { initHeader } from '../scripts/header';
  initHeader();
</script>
