---
interface Props {
  /** Inner markup of the icon <svg> wrapper (an inline <svg>). */
  icon: string;
  title: string;
  delay?: string;
}
const { icon, title, delay } = Astro.props;
const delayClass: Record<string, string> = { '1': '[transition-delay:0.1s]', '2': '[transition-delay:0.2s]', '3': '[transition-delay:0.3s]' };
---

<div class:list={["flex flex-col [&_h3]:text-[19px] [&_h3]:mt-5 [&_p]:mt-2.5! [&_p]:text-[14px]! [&_p]:leading-[1.65] [&_p]:text-[#55534f]", "opacity-[0] [transform:translateY(32px)] [transition:opacity_0.7s_ease,_transform_0.7s_ease] [&.is-visible]:opacity-[1] [&.is-visible]:[transform:translateY(0)] reveal", delay && delayClass[delay]]}>
  <span class="w-13 h-13 rounded-[50%] border border-brand-yellow flex items-center justify-center text-brand-yellow-dark shrink-0 [&_svg]:w-5.5 [&_svg]:h-5.5" set:html={icon} />
  <h3 set:html={title} />
  <p><slot /></p>
</div>
