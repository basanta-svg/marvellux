---
import JourneyCard from './JourneyCard.astro';
---

<section class="py-30 px-0 bg-soft-white overflow-hidden max-[1023px]:pt-20 max-[1023px]:pb-20 max-[767px]:pt-16 max-[767px]:pb-16 journeys" id="journeys">
    <div class="flex flex-col gap-10 min-[960px]:flex-row min-[960px]:items-center min-[960px]:gap-0">
      <div class="opacity-[0] [transform:translateY(32px)] [transition:opacity_0.7s_ease,_transform_0.7s_ease] [&.is-visible]:opacity-[1] [&.is-visible]:[transform:translateY(0)] py-0 px-(--gutter) min-[960px]:flex-[0_0_460px] min-[960px]:pl-(--gutter) min-[960px]:pr-14 max-[959px]:text-left journeys-intro reveal">
        <p class="font-body font-semibold text-[12px] tracking-[0.18em] uppercase text-brand-yellow">SCHEDULED DEPARTURES</p>
        <h2 class="text-[length:clamp(30px,_4vw,_44px)] mt-3.5">Upcoming Journeys</h2>
        <p class="font-body text-[16px] text-[#55534f] max-w-140 mt-4 [.journeys-intro_&]:ml-0 [.journeys-intro_&]:max-w-95">A rotating edit of departures bookable now — each one a starting point, never a fixed script.</p>
      </div>

      <div class="min-w-0 min-[960px]:flex-1">
        <div class="relative overflow-hidden pl-(--gutter) min-[960px]:pl-0">
          <div class="absolute left-5 right-5 top-26.75 z-6 flex justify-between pointer-events-none min-[481px]:top-34.25 min-[960px]:top-44.25 journeys-arrows">
            <button class="w-11.5 h-11.5 rounded-none bg-transparent border border-charcoal-line flex items-center justify-center [transition:background_0.3s_ease,_color_0.3s_ease,_border-color_0.3s_ease] [&_svg]:w-4.5 [&_svg]:h-4.5 hover:bg-brand-yellow hover:border-brand-yellow disabled:opacity-[0.35] disabled:pointer-events-none [.journeys-arrows_&]:pointer-events-auto! [.journeys-arrows_&]:bg-[rgba(250,250,248,0.88)] [.journeys-arrows_&]:[backdrop-filter:blur(2px)] [.journeys-arrows_&]:border-transparent! [.journeys-arrows_&:hover]:bg-brand-yellow! journey-prev" aria-label="Previous journeys"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 6l-6 6 6 6"></path></svg></button>
            <button class="w-11.5 h-11.5 rounded-none bg-transparent border border-charcoal-line flex items-center justify-center [transition:background_0.3s_ease,_color_0.3s_ease,_border-color_0.3s_ease] [&_svg]:w-4.5 [&_svg]:h-4.5 hover:bg-brand-yellow hover:border-brand-yellow disabled:opacity-[0.35] disabled:pointer-events-none [.journeys-arrows_&]:pointer-events-auto! [.journeys-arrows_&]:bg-[rgba(250,250,248,0.88)] [.journeys-arrows_&]:[backdrop-filter:blur(2px)] [.journeys-arrows_&]:border-transparent! [.journeys-arrows_&:hover]:bg-brand-yellow! journey-next" aria-label="Next journeys"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6"></path></svg></button>
          </div>
          <div class="flex gap-6 cursor-grab select-none [will-change:transform] [transition:transform_0.6s_cubic-bezier(0.65,_0,_0.35,_1)] [&.dragging]:cursor-grabbing [&.dragging]:[transition:none] journey-track">
            <JourneyCard image={"/images/by-marcus-westberg-punakha-2023_21.jpg"} alt={"Village and dzong on a forested hillside in Punakha"} badge={"Cultural"} date={"14 Oct 2026"} group={"Private Journey"} title={"The Essence of Bhutan"} duration={"7 Days, 6 Nights"} href={"#contact"} />

            <JourneyCard image={"/images/bumthang-180723-by-amp-sripimanwat-21.jpg"} alt={"Hillside monastery and village overlooking the Bumthang valley"} badge={"Trekking"} date={"2 Nov 2026"} group={"Private Journey"} title={"Trails of the Higher Himalaya"} duration={"10 Days, 9 Nights"} href={"#contact"} />

            <JourneyCard image={"/images/lll05267.jpg"} alt={"Masked dancers in a circle formation at a Bhutanese tsechu"} badge={"Festival"} date={"27 Sep 2026"} group={"Private Journey"} title={"Festivals &amp; Sacred Valleys"} duration={"9 Days, 8 Nights"} href={"#contact"} />

            <JourneyCard image={"/images/ogyen-choling-by-matt-dutile13.jpg"} alt={"A guest room doorway at a restored heritage lodge in Bumthang"} badge={"Heritage Stays"} date={"9 Nov 2026"} group={"Private Journey"} title={"Manor Houses of Bumthang"} duration={"6 Days, 5 Nights"} href={"#contact"} />

            <JourneyCard image={"/images/marcus-westberg-bumthang-202312.jpg"} alt={"Raptors circling the fortified walls of a hilltop dzong in Bumthang"} badge={"Wilderness"} date={"21 Nov 2026"} group={"Private Journey"} title={"Valleys of the Black-Necked Crane"} duration={"8 Days, 7 Nights"} href={"#contact"} />
          </div>
        </div>
      </div>
    </div>
  </section>

<script>
  import '../scripts/journeys-carousel.ts';
</script>
