---
import { experiences, information, about, contact } from '../data/nav';

// The footer's "About" column differs slightly from the header dropdown.
const aboutLinks = [about[0], about[1], about[3], { label: 'Contact', href: '/contact.html' }];
const columns = [
  { title: 'Experiences', links: experiences },
  { title: 'Information', links: information },
  { title: 'About', links: aboutLinks },
];
const social = [
  { label: 'Instagram', svg: '<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1"/>' },
  { label: 'Facebook', svg: '<path d="M15 8h-2a2 2 0 00-2 2v10M8 13h5"/><path d="M13 21V8a2 2 0 012-2h2"/>' },
  { label: 'YouTube', svg: '<rect x="3" y="6" width="18" height="12" rx="3"/><path d="M11 10l4 2-4 2z" fill="currentColor" stroke="none"/>' },
  { label: 'WhatsApp', svg: '<path d="M21 11.5a8.4 8.4 0 01-8.9 8.4 8.5 8.5 0 01-4.1-1.1L3 20l1.2-4.9A8.4 8.4 0 1121 11.5z"/>' },
];
---

<footer class="bg-charcoal text-soft-white pt-22.5" id="contact">
  <div class="max-w-320 my-0 mx-auto py-0 px-(--gutter)">
    <div class="grid grid-cols-1 gap-12 pb-16 border-b border-b-white-line min-[720px]:grid-cols-2 min-[1100px]:grid-cols-[1.4fr_0.8fr_0.8fr_0.8fr_1.2fr]">
      <div class="[&_img]:h-20">
        <img src="/images/marvels-luxe-bhutan-white-logo.png" alt="Marvels Luxe" />
        <p class="font-heading text-[16px] mt-4.5 text-[rgba(250,250,248,0.9)]">Luxury travel, rooted in Bhutan.</p>
        <div class="mt-5.5 flex flex-col gap-2.5 text-[14px] text-[rgba(250,250,248,0.72)] [&_a:hover]:text-brand-yellow">
          <a href={contact.phoneHref}>{contact.phone}</a>
          <a href={`mailto:${contact.email}`}>{contact.email}</a>
          <span>{contact.address}</span>
        </div>
        <div class="flex gap-2.5 mt-6 [&_a]:w-9.5 [&_a]:h-9.5 [&_a]:rounded-[50%] [&_a]:border [&_a]:border-white-line [&_a]:flex [&_a]:items-center [&_a]:justify-center [&_a]:[transition:background_0.3s_ease,_border-color_0.3s_ease] [&_a_svg]:w-3.75! [&_a_svg]:h-3.75! [&_a:hover]:bg-brand-yellow [&_a:hover]:border-brand-yellow! [&_a:hover]:text-charcoal">
          {
            social.map((s) => (
              <a href="#" aria-label={s.label}>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" set:html={s.svg} />
              </a>
            ))
          }
        </div>
      </div>

      {
        columns.map((col) => (
          <div class="[&_h4]:text-[12px] [&_h4]:tracking-[0.14em] [&_h4]:uppercase [&_h4]:text-brand-yellow [&_h4]:font-body [&_h4]:font-semibold [&_ul]:mt-5 [&_ul]:flex [&_ul]:flex-col [&_ul]:gap-3 [&_a]:text-[14px]! [&_a]:text-[rgba(250,250,248,0.72)] [&_a]:[transition:color_0.3s_ease,_padding-left_0.3s_ease] [&_a:hover]:text-brand-yellow! [&_a:hover]:pl-1">
            <h4>{col.title}</h4>
            <ul>
              {col.links.map((l) => (
                <li>
                  <a href={l.href}>{l.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }

      <div class="[&_h4]:text-[12px] [&_h4]:tracking-[0.14em] [&_h4]:uppercase [&_h4]:text-brand-yellow [&_h4]:font-body [&_h4]:font-semibold [&_ul]:mt-5 [&_ul]:flex [&_ul]:flex-col [&_ul]:gap-3 [&_a]:text-[14px] [&_a]:text-[rgba(250,250,248,0.72)] [&_a]:[transition:color_0.3s_ease,_padding-left_0.3s_ease] [&_a:hover]:text-brand-yellow! [&_a:hover]:pl-1 [&_p]:text-[14px]! [&_p]:text-[rgba(250,250,248,0.7)] [&_p]:mt-3.5! [&_p]:max-w-65">
        <h4>Newsletter</h4>
        <p>Notes from the valleys — new journeys, festival dates and seasonal openings. No more than once a month.</p>
        <form class="mt-5 flex border-b border-b-white-line pb-2.5 [&_input]:flex-1 [&_input]:bg-transparent [&_input]:border-0 [&_input]:text-soft-white [&_input]:text-[14px] [&_input]:outline-none [&_input::placeholder]:text-[rgba(250,250,248,0.45)]! [&_button]:text-brand-yellow [&_button]:font-semibold [&_button]:text-[12px]! [&_button]:tracking-[0.06em] [&_button]:uppercase [&_button]:whitespace-nowrap newsletter-form">
          <input type="email" required placeholder="Your email address" aria-label="Email address" />
          <button type="submit">Subscribe →</button>
        </form>
        <p class="mt-3 text-[12px] text-brand-yellow opacity-[0] [transition:opacity_0.3s_ease] [&.show]:opacity-[1] newsletter-note">Thank you — you're on the list.</p>
      </div>
    </div>

    <div class="pt-6.5 pr-0 pb-10 pl-0 flex flex-col gap-3.5 text-[12px] text-[rgba(250,250,248,0.55)] min-[720px]:flex-row min-[720px]:justify-between min-[720px]:items-center">
      <span>© 2026 Marvels Luxe Bhutan. All rights reserved.</span>
      <div class="flex gap-5 flex-wrap [&_a:hover]:text-brand-yellow">
        <a href="#">Terms</a>
        <a href="#">Privacy</a>
        <a href="#">Cancellation Policy</a>
      </div>
    </div>
  </div>
</footer>

<script>
  import '../scripts/newsletter';
</script>
