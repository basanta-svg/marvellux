---
interface Props {
  q: string;
  open?: boolean;
}
const { q, open = false } = Astro.props;
---

<div class:list={["border-b border-b-charcoal-line faq-item", { open }]}>
  <button class="w-full flex items-center justify-between gap-5 py-5.5 px-0.5 text-left font-body font-semibold text-[15.5px] [.faq-item.open_&]:text-brand-yellow-dark faq-question" aria-expanded={open ? 'true' : 'false'}>{q}<span class="[.faq-question_&]:w-4.5 [.faq-question_&]:h-4.5 [.faq-question_&]:relative [.faq-question_&]:shrink-0 [.faq-question_&::before]:content-[''] [.faq-question_&::before]:absolute [.faq-question_&::before]:bg-charcoal [.faq-question_&::before]:[transition:transform_0.3s_ease,_background_0.3s_ease] [.faq-question_&::after]:content-['']! [.faq-question_&::after]:absolute! [.faq-question_&::after]:bg-charcoal [.faq-question_&::after]:[transition:transform_0.3s_ease,_background_0.3s_ease]! [.faq-question_&::before]:top-1/2 [.faq-question_&::before]:left-0 [.faq-question_&::before]:w-full [.faq-question_&::before]:h-0.5 [.faq-question_&::before]:[transform:translateY(-50%)] [.faq-question_&::after]:left-1/2! [.faq-question_&::after]:top-0! [.faq-question_&::after]:h-full! [.faq-question_&::after]:w-0.5! [.faq-question_&::after]:[transform:translateX(-50%)] [.faq-item.open_.faq-question_&::after]:[transform:translateX(-50%)_rotate(90deg)]! [.faq-item.open_.faq-question_&::after]:opacity-[0] [.faq-item.open_.faq-question_&::before]:bg-brand-yellow!"></span></button>
  <div class="max-h-0 overflow-hidden [transition:max-height_0.5s_ease] [&_p]:pt-0 [&_p]:pr-0.5 [&_p]:pb-6 [&_p]:pl-0.5 [&_p]:text-[14.5px] [&_p]:text-[#56534e] [&_p]:max-w-120 faq-answer" style={open ? 'max-height:400px' : undefined}><slot /></div>
</div>

<script>
  import '../scripts/faq';
</script>
