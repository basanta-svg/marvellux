---
interface Props {
  image: string;
  alt: string;
  /** May contain inline HTML entities such as &amp;. */
  title: string;
  duration: string;
  group: string;
  /** Destination of the call-to-action button. */
  href: string;
  cta?: string;
  /** When set, the image and title link to `href` and the image link gets this aria-label. */
  mediaLabel?: string;
  /** Stagger the scroll reveal (1–3). */
  delay?: string;
  /** Extra classes for the image (e.g. object-top to anchor the crop). */
  imageClass?: string;
}
const { image, alt, title, duration, group, href, cta = 'Enquire Now', mediaLabel, delay, imageClass } = Astro.props;
const delayClass: Record<string, string> = { '1': '[transition-delay:0.1s]', '2': '[transition-delay:0.2s]', '3': '[transition-delay:0.3s]' };
---

<article class:list={["after:content-[''] after:absolute after:inset-0 after:[background:linear-gradient(180deg,_rgba(0,0,0,0.15)_0%,_rgba(0,0,0,0.35)_45%,_rgba(0,0,0,0.85)_100%)] after:pointer-events-none [&_img]:absolute! [&_img]:inset-0! [&_img]:w-full [&_img]:h-full [&_img]:object-cover [&_img]:[transition:transform_0.9s_ease] [&:hover_img]:[transform:scale(1.08)] relative overflow-hidden h-[clamp(480px,_78vh,_780px)]", "opacity-[0] [transform:translateY(32px)] [transition:opacity_0.7s_ease,_transform_0.7s_ease] [&.is-visible]:opacity-[1] [&.is-visible]:[transform:translateY(0)] reveal", delay && delayClass[delay]]}>
  {
    mediaLabel ? (
      <a href={href} class="absolute inset-0 z-0 block" aria-label={mediaLabel}>
        <img src={image} alt={alt} class={imageClass} loading="lazy" />
      </a>
    ) : (
      <img src={image} alt={alt} class={imageClass} loading="lazy" />
    )
  }
  <div class="absolute inset-0 z-2 pt-7 pr-6 pb-5.5 pl-6 text-soft-white pointer-events-none">
    <div class="absolute top-[26%] left-6 right-6 pointer-events-auto">
      <h3 class="font-heading text-[20px] uppercase text-soft-white">
        {mediaLabel ? <a href={href} set:html={title} /> : <Fragment set:html={title} />}
      </h3>
      <div class="flex flex-wrap gap-y-2.5 gap-x-4.5 mt-3.5">
        <span class="inline-flex items-center gap-1.5 text-[12px] font-semibold tracking-[0.03em] uppercase text-[rgba(250,250,248,0.85)] [&_svg]:w-3.5 [&_svg]:h-3.5 [&_svg]:shrink-0 [&_svg]:text-brand-yellow">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3.5 2"></path></svg>
          {duration}
        </span>
        <span class="inline-flex items-center gap-1.5 text-[12px] font-semibold tracking-[0.03em] uppercase text-[rgba(250,250,248,0.85)] [&_svg]:w-3.5 [&_svg]:h-3.5 [&_svg]:shrink-0 [&_svg]:text-brand-yellow">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="3.2"></circle><path d="M5.5 20c0-3.9 2.9-7 6.5-7s6.5 3.1 6.5 7"></path></svg>
          {group}
        </span>
      </div>
    </div>
    <a href={href} class="block pt-3.5 border-t border-t-brand-yellow text-[12px] font-semibold tracking-[0.08em] uppercase text-brand-yellow [transition:color_0.3s_ease] hover:text-soft-white absolute left-6 right-6 bottom-5.5 pointer-events-auto">{cta}</a>
  </div>
</article>
