---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import TourCard from '../components/TourCard.astro';
import FinalCta from '../components/FinalCta.astro';
---

<BaseLayout
  title="Cultural Journeys | Marvels Luxe Bhutan"
  description="Six curated cultural journeys through Bhutan — dzongs, sacred monasteries, heritage manor stays, living villages, Tshechu festivals and textile trails, private and led by our Bhutan-based team."
  ogImage="/images/thimphu-tshechu-by-bassem-nimah83.jpg"
>
  <!-- ================================ PAGE HERO ================================ -->
    <PageHero image={"/images/thimphu-tshechu-by-bassem-nimah83.jpg"} title={"Cultural Journeys"} />

    <!-- ================================ TOUR CARDS ================================ -->
    <section class="py-30 px-0 bg-soft-white max-[1023px]:pt-20 max-[1023px]:pb-20 max-[767px]:pt-16 max-[767px]:pb-16" id="tours">
      <div class="max-w-320 my-0 mx-auto py-0 px-(--gutter)">
        <div class="opacity-[0] [transform:translateY(32px)] [transition:opacity_0.7s_ease,_transform_0.7s_ease] [&.is-visible]:opacity-[1] [&.is-visible]:[transform:translateY(0)] max-w-170 mb-14 reveal">
          <h2 class="text-[length:clamp(30px,_4vw,_44px)] mt-3.5">Choose Your Cultural Journey</h2>
          <p class="font-body text-[16px] text-[#55534f] max-w-140 mt-4">Every itinerary below is a starting point. Combine, extend or slow one down — our Bhutan-based team will shape it around your dates and pace.</p>
        </div>

        <div class="grid grid-cols-1 gap-9 min-[640px]:grid-cols-2 min-[1024px]:grid-cols-3 min-[1024px]:gap-8">

          <TourCard image={"/images/jakar-dzong-1.jpg"} alt={"Jakar Dzong fortress-monastery on a forested hillside with blossoming trees in the foreground"} title={"Dzongs of the Western Valleys"} duration={"6 Days, 5 Nights"} group={"Private Journey"} href={"/dzongs-western-valleys.html"} cta={"Read More"} mediaLabel={"View the Dzongs of the Western Valleys itinerary"} />

          <TourCard image={"/images/kurje-lhakhang.jpg"} alt={"Kurje Lhakhang temple beneath strings of prayer flags in Bumthang"} title={"Monasteries of the Sacred Valley"} duration={"5 Days, 4 Nights"} group={"Private Journey"} href={"/contact.html"} cta={"Read More"} delay={"1"} />

          <TourCard image={"/images/ogyen-choling-by-matt-dutile13.jpg"} alt={"Doorway of a restored heritage manor house at Ogyen Choling"} title={"Heritage Manor Stays"} duration={"6 Days, 5 Nights"} group={"Private Journey"} href={"/contact.html"} cta={"Read More"} delay={"2"} />

          <TourCard image={"/images/trashiyangtse-town.jpg"} alt={"Traditional village street in Trashiyangtse, eastern Bhutan"} title={"Villages of the Eastern Frontier"} duration={"8 Days, 7 Nights"} group={"Private Journey"} href={"/contact.html"} cta={"Read More"} />

          <TourCard image={"/images/dechenphu-festival5.jpg"} alt={"Masked dancers performing at a Bhutanese Tshechu festival"} title={"Tshechu Festivals &amp; Masked Dances"} duration={"7 Days, 6 Nights"} group={"Private Journey"} href={"/contact.html"} cta={"Read More"} delay={"1"} />

          <TourCard image={"/images/lll06468.jpg"} alt={"Portrait of a woman in an intricately woven traditional dress and silver jewellery"} title={"Textile Trails &amp; Living Crafts"} duration={"6 Days, 5 Nights"} group={"Private Journey"} href={"/contact.html"} cta={"Read More"} delay={"2"} />

        </div>
      </div>
    </section>

    <!-- ================================ FINAL CTA ================================ -->
    <FinalCta  />
</BaseLayout>
